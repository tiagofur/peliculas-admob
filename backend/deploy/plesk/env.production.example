# Copia a /opt/peliculas/.env en el servidor (chmod 600). Nunca se commitea.
# Genera secretos con: openssl rand -base64 32  /  openssl rand -base64 48

TMDB_API_KEY=
POSTGRES_PASSWORD=
JWT_SECRET=

# Detrás del nginx de Plesk
TRUST_PROXY=true
API_PORT=8787
DOMAIN=api-peliculas.creapolis.dev

# Apple (Team T5SKULSP2M, clave U73X59U2VH: APNs + Sign in with Apple)
APPLE_CLIENT_IDS=mx.creapolis.peliculas.native
APPLE_TEAM_ID=T5SKULSP2M
APPLE_KEY_ID=U73X59U2VH
# Contenido del .p8 en una línea:  awk 'NR>1{printf "\\n"}{printf "%s",$0}' AuthKey_U73X59U2VH.p8
APPLE_PRIVATE_KEY=""

STOREKIT_BUNDLE_ID=mx.creapolis.peliculas.native
PRO_PRODUCT_IDS=peliculas_pro_monthly,peliculas_pro_yearly,peliculas_pro_lifetime

APNS_KEY_ID=U73X59U2VH
APNS_PRIVATE_KEY=""
PUSH_PRO_ONLY=true

# Android. Claves JSON en una línea y entre comillas simples:  jq -c . clave.json
FCM_CREDENTIALS_JSON=''
PLAY_CREDENTIALS_JSON=''
PLAY_PACKAGE_NAME=mx.creapolis.peliculas.android
# openssl rand -hex 24 — la URL de push de Pub/Sub termina en ?token=<esto>
PLAY_RTDN_TOKEN=
