# Copy to .env (never commit .env)

# TMDB: one of the two. The v4 read token is preferred.
TMDB_API_KEY=
TMDB_READ_TOKEN=

# Postgres password used by docker compose
POSTGRES_PASSWORD=change-me

# Auth. Generate with: openssl rand -base64 48
JWT_SECRET=

# Sign in with Apple: iOS bundle ID first (+ Services ID for web), comma separated
APPLE_CLIENT_IDS=
# Optional but needed for App Review: revoke Apple tokens when an account is deleted.
# Key from developer.apple.com → Keys (Sign in with Apple). PEM with \n for newlines.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Google Sign-In OAuth client IDs (iOS, Android, web), comma separated
GOOGLE_CLIENT_IDS=

# Pro (StoreKit 2). Bundle ID defaults to the first APPLE_CLIENT_IDS.
STOREKIT_BUNDLE_ID=mx.creapolis.peliculas.native
PRO_PRODUCT_IDS=peliculas_pro_monthly,peliculas_pro_yearly,peliculas_pro_lifetime

# Push (APNs). Key from developer.apple.com → Keys (Apple Push Notifications service).
# Team ID defaults to APPLE_TEAM_ID, topic to STOREKIT_BUNDLE_ID.
APNS_KEY_ID=
APNS_PRIVATE_KEY=
# Push (FCM, Android): service account JSON (inline or a file path).
FCM_CREDENTIALS_JSON=
# FCM_PROJECT_ID=          # defaults to the key's project_id

# Google Play (Pro on Android). Product IDs default to PRO_PRODUCT_IDS.
PLAY_CREDENTIALS_JSON=
# PLAY_PACKAGE_NAME=mx.creapolis.peliculas.android
# PLAY_PRODUCT_IDS=peliculas_pro_monthly,peliculas_pro_yearly,peliculas_pro_lifetime
# PLAY_ONE_TIME_PRODUCT_IDS=peliculas_pro_lifetime
PLAY_RTDN_TOKEN=           # openssl rand -hex 24; push URL ends in ?token=<this>
# PLAY_RTDN_AUDIENCE=      # OIDC audience on the Pub/Sub push subscription
# PLAY_RTDN_EMAIL=         # service account that signs the push

# PUSH_PRO_ONLY=true      # new-episode alerts only for Pro users
# PUSH_ALERT_HOUR=18      # local hour from which "aired today" alerts go out
# PUSH_INTERVAL=1h

# Migration from Supabase (only while moving data): Session pooler URL, port 5432
# SUPABASE_DB_URL=

# Only on the VPS (with --profile prod)
DOMAIN=api.example.com
TRUST_PROXY=true

# Optional tuning
# MEM_CACHE_ENTRIES=5000
# CACHE_STALE_MAX=720h
