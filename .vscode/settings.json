{
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit",
    "source.organizeImports": "explicit"
  },

  "editor.fontLigatures": false,

  "command-runner.commands": {
    "pub get": "flutter pub get",
    "build_runner": "flutter pub run build_runner build",
    "build_runaer_clear": "flutter pub run build_runner build --delete-conflicting-outputs"
  },

  // Configuración de CMake para evitar errores
  "cmake.configureOnOpen": false,
  "cmake.automaticConfiguring": false,
  "cmake.sourceDirectory": "C:/Users/tfurt/source/repos/peliculas-admob/windows",
  "cmake.buildDirectory": "${workspaceFolder}/build/windows",
  "cmake.ignoreCMakeListsMissing": true,
  "cmake.skipConfigureIfCachePresent": false,

  // Excluir archivos ephemeral que se generan dinámicamente
  "files.exclude": {
    "**/windows/flutter/ephemeral/**": true,
    "**/build/**": true,
    "**/.dart_tool/**": true
  },
  "files.watcherExclude": {
    "**/windows/flutter/ephemeral/**": true,
    "**/build/**": true,
    "**/.dart_tool/**": true
  },

  // Deshabilitar IntelliSense de C++ para evitar conflictos
  "C_Cpp.errorSquiggles": "Disabled",
  "C_Cpp.intelliSenseEngine": "Disabled"
}
