// Valores comunes a Debug y Release.
// Lo que es tuyo (URL de producción, IDs reales de AdMob, Team ID) va en
// Secrets.generated.xcconfig, que genera scripts/sync-env.sh (gitignored).
//
// Ojo: en un .xcconfig "//" empieza un comentario. Por eso las URLs se
// escriben como https:/$()/dominio — Xcode lo deja en https://dominio.

// Identidad de la app. Si esta app sustituye a la Flutter ya publicada,
// usa el mismo bundle ID que esa (mx.creapolis.peliculas) — ver tutorial.
APP_BUNDLE_ID = mx.creapolis.peliculas.native
DEVELOPMENT_TEAM = T5SKULSP2M
MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 1

// Backend Go. DEV = simulador contra `docker compose` local (API_PORT=8787).
API_BASE_URL_DEV = http:/$()/127.0.0.1:8787
API_BASE_URL_PROD = https:/$()/api-peliculas.creapolis.dev

// AdMob. El App ID es el mismo de la app Flutter. En Debug siempre se usa
// el banner de prueba oficial de Google.
GAD_APPLICATION_ID = ca-app-pub-3460220325831299~7925363454
GAD_AD_UNIT_ID_TEST = ca-app-pub-3940256099942544/2934735716
GAD_AD_UNIT_ID_PROD = ca-app-pub-3940256099942544/2934735716

// Páginas legales (obligatorias en App Store Connect y dentro de la app).
PRIVACY_URL = https:/$()/creapolis.dev/privacidad/
TERMS_URL = https:/$()/creapolis.dev/terminos/
SUPPORT_URL = https:/$()/creapolis.dev/es/contacto/
